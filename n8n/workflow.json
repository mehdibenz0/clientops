                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "Route",
      "name": "Internal Task Needed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        20,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "id": "ReturnStandard",
      "name": "Return Resolution Packet",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        320,
        -110
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\"status\":\"task_drafted\",\"packet\":$json} }}"
      },
      "id": "ReturnTask",
      "name": "Return Task Draft",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        320,
        120
      ]
    }
  ],
  "connections": {
    "Webhook Intake": {
      "main": [
        [
          {
